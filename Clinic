// 관련 클리닉 (현재 클리닉 제외)
const relatedInfo = {
  rheumatoid: { icon:'🦴', name:'류마티스·통증 센터' },
  autonomic: { icon:'🧠', name:'자율신경 센터' },
  iv: { icon:'💉', name:'프리미엄 수액·웰빙' },
  thyroid: { icon:'🫀', name:'갑상선·내분비' },
  obesity: { icon:'⚖️', name:'비만·메디컬 다이어트' },
  allergy: { icon:'🌸', name:'알레르기·호흡기' },
  endoscopy: { icon:'🔬', name:'소화기·내시경' },
  chronic: { icon:'❤️‍🩹', name:'만성질환·성인병' },
};

// URL 해시에서 클리닉 ID 추출
function getClinicId(){
  const hash = window.location.hash.replace('#','');
  return clinics[hash] ? hash : 'rheumatoid';
}

// 페이지 렌더링
function renderPage(){
  const id = getClinicId();
  const c = clinics[id];

  // hero
  document.getElementById('heroBg').style.background = c.bgGradient;
  document.getElementById('clinicHero').style.minHeight = '280px';
  document.getElementById('breadcrumbCurrent').textContent = c.titlePlain;
  document.getElementById('clinicTag').textContent = c.tag;
  document.getElementById('clinicTitle').innerHTML = c.title;
  document.getElementById('clinicSubtitle').textContent = c.subtitle;
  document.getElementById('heroBadge').innerHTML = `<span style="font-size:3rem">${c.icon}</span>`;

  // body
  document.getElementById('clinicBody').innerHTML = c.body;

  // 예약 모달 클리닉명
  document.getElementById('reserveClinic').value = c.titlePlain;
  document.getElementById('inquiryClinic').value = c.titlePlain;

  // 페이지 타이틀
  document.title = `${c.titlePlain} — MEDIVITA`;

  // 관련 클리닉 (현재 제외, 4개)
  const relatedGrid = document.getElementById('relatedGrid');
  const others = Object.entries(relatedInfo)
    .filter(([k]) => k !== id)
    .slice(0, 4);
  relatedGrid.innerHTML = others.map(([k, v]) =>
    `<a href="clinic.html#${k}" class="related-card" onclick="setTimeout(()=>renderPage(),50)">
      <span class="r-icon">${v.icon}</span>
      <div class="r-name">${v.name}</div>
      <div class="r-desc">자세히 보기 →</div>
    </a>`
  ).join('');
}

// 모달
function openModal(type){
  document.getElementById(type+'Modal').classList.add('show');
  document.body.style.overflow='hidden';
}
function closeModal(type){
  document.getElementById(type+'Modal').classList.remove('show');
  document.body.style.overflow='';
  // 성공 메시지 초기화
  document.getElementById(type+'Form').style.display='block';
  document.getElementById(type+'Success').style.display='none';
}
function submitForm(type){
  document.getElementById(type+'Form').style.display='none';
  document.getElementById(type+'Success').style.display='block';
}
document.querySelectorAll('.modal-overlay').forEach(el=>{
  el.addEventListener('click', e=>{
    if(e.target===el) closeModal(el.id.replace('Modal',''));
  });
});

// 초기화
window.addEventListener('hashchange', ()=>{ renderPage(); window.scrollTo(0,0); });
window.addEventListener('load', ()=>{
  renderPage();
  setTimeout(()=>{
    document.getElementById('loading').style.opacity='0';
    setTimeout(()=>document.getElementById('loading').style.display='none', 300);
  }, 400);
});
</script>
